msgctxt "Addons::name::ee_first_purchase_verivication"
msgid "[efimchenko.com] First purchase promotion condition"
msgstr "[efimchenko.com] Promotion extensions"

msgctxt "Addons::description::ee_first_purchase_verivication"
msgid "Adds a cart promotion condition that is fulfilled only when a registered customer has no previous orders."
msgstr "Adds the first purchase condition and a promotion bonus that sets a target reward points percentage for matching products."

